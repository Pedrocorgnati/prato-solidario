# ─────────────────────────────────────────────────────────────────────────────
# Prato Solidário — Exemplo de variáveis para Docker Compose
# Copie para .env.docker e preencha os valores reais
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# PostgreSQL (serviço Docker — host = "db")
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pratosolidario_dev
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/pratosolidario_dev
DIRECT_URL=postgresql://postgres:CHANGE_ME@db:5432/pratosolidario_dev

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-token
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# Autenticação — gere com: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME

# Segurança — gere com: openssl rand -hex 32
CRON_SECRET=CHANGE_ME

# Email (Resend)
RESEND_API_KEY=re_...

# Pagamentos (Mercado Pago)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# Monitoramento (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=prato-solidario

# Vercel
VERCEL_URL=
VERCEL_ENV=development
NEXT_PHASE=
CI=
