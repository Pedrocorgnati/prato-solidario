# ============================================
# VARIAVEIS DE AMBIENTE - PRATO SOLIDÁRIO
# ============================================
# Copie este arquivo para .env e preencha com seus valores
# npm run dev irá usar as variáveis do .env
# ============================================

# ────────────────────────────────────────────
# AMBIENTE E APLICACAO
# ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=https://pratosolidario.com.br
NEXT_PUBLIC_APP_URL_WWW=https://www.pratosolidario.com.br
APP_URL=http://localhost:3000

# ────────────────────────────────────────────
# BANCO DE DADOS
# ────────────────────────────────────────────
# PostgreSQL local (desenvolvimento)
# Para production, use Supabase connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pratosolidario
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/pratosolidario

# ────────────────────────────────────────────
# SUPABASE (Backend-as-a-Service)
# ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ────────────────────────────────────────────
# MAPBOX (Mapa e Geolocalização)
# ────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# ────────────────────────────────────────────
# AUTENTICAÇÃO
# ────────────────────────────────────────────
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-32

# ────────────────────────────────────────────
# SEGURANÇA - Secrets de Endpoint
# ────────────────────────────────────────────
# Gere com: openssl rand -hex 32
CRON_SECRET=gere-com-openssl-rand-hex-32

# ────────────────────────────────────────────
# EMAIL (Resend)
# ────────────────────────────────────────────
RESEND_API_KEY=re_sua-chave-aqui

# ────────────────────────────────────────────
# PAGAMENTOS (Mercado Pago)
# ────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=TEST-sua-chave-aqui
MERCADOPAGO_PUBLIC_KEY=TEST-sua-chave-aqui
MERCADOPAGO_WEBHOOK_SECRET=sua-webhook-secret

# ────────────────────────────────────────────
# PUSH NOTIFICATIONS (Expo)
# ────────────────────────────────────────────
EXPO_ACCESS_TOKEN=seu-token-expo

# ────────────────────────────────────────────
# MONITORAMENTO E ERROR TRACKING (Sentry)
# ────────────────────────────────────────────
SENTRY_DSN=https://sua-chave@sentry.io/seu-id
NEXT_PUBLIC_SENTRY_DSN=https://sua-chave@sentry.io/seu-id
SENTRY_AUTH_TOKEN=seu-auth-token
SENTRY_ORG=seu-org-slug
SENTRY_PROJECT=prato-solidario

# ────────────────────────────────────────────
# VERCEL (Deployment)
# ────────────────────────────────────────────
# Preenchidas automaticamente em production
VERCEL_URL=
VERCEL_ENV=development

# ────────────────────────────────────────────
# NEXT.JS (Internas)
# ────────────────────────────────────────────
NEXT_PHASE=
CI=

# ────────────────────────────────────────────
# CORS / RATE LIMIT (intake-review TASK-1)
# ────────────────────────────────────────────
# Origens permitidas em producao (csv). Suporta wildcard: *.vercel.app
# Exemplo: https://prato-solidario.app,https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Rate limit default (requests/min) por IP em rotas /api/v1/*
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_CODES=20
RATE_LIMIT_CONTACT=3

# Upstash (opcional — fallback para memoria em dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ────────────────────────────────────────────
# OBSERVABILIDADE (intake-review TASK-2)
# ────────────────────────────────────────────
LOG_LEVEL=info
